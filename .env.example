PORT=3000

# Turso (libSQL) Cloud Database
# Kosongkan TURSO_DATABASE_URL untuk otomatis menggunakan SQLite lokal (file:serverpulse.db)
TURSO_DATABASE_URL=libsql://serverpulse-ta-username.turso.io
TURSO_AUTH_TOKEN=

# CORS & URL Publik Netlify
ALLOWED_ORIGINS=https://tugas-akhir-113.netlify.app,https://agent-6b0af3e7da12609e0abf0491--tugas-akhir-113.netlify.app
PUBLIC_DASHBOARD_URL=https://tugas-akhir-113.netlify.app

# Worker Background & Bridge
ENABLE_BACKGROUND_WORKERS=true
ENABLE_TAILSCALE_BRIDGE=true

# Batas baris tabel metrics saat menjalankan npm run db:migrate
METRICS_LIMIT=500
